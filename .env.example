# =============================================================================
# Variables de entorno — Hotel San Francisco API
# Copia este archivo como referencia para configurar Railway (o tu entorno).
# Los valores aquí son EJEMPLOS; reemplázalos por valores reales y secretos.
# =============================================================================

# --- Base de datos (PostgreSQL) -------------------------------------------
# En Railway, referencia el servicio Postgres con plantillas:
#   DATABASE_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
#   DATABASE_USERNAME=${{Postgres.PGUSER}}
#   DATABASE_PASSWORD=${{Postgres.PGPASSWORD}}
# Nota: la URL DEBE empezar con jdbc:postgresql:// (no el postgresql:// crudo).
DATABASE_URL=jdbc:postgresql://localhost:5432/hotel_sf
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme

# --- Servidor --------------------------------------------------------------
# Railway inyecta PORT automáticamente; normalmente NO necesitas definirlo.
# PORT=8080
APP_TIMEZONE=America/Lima

# --- Seguridad / JWT -------------------------------------------------------
# OBLIGATORIA: la app no arranca sin ella. Mínimo 32 caracteres, aleatoria y secreta.
JWT_SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria_de_32+_chars
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# --- Cookies ---------------------------------------------------------------
# En producción (HTTPS): secure=true. Si el frontend está en OTRO dominio,
# same-site debe ser None (requiere secure=true) para enviar cookies cross-site.
APP_COOKIE_SECURE=true
APP_COOKIE_SAMESITE=None

# --- Protección CSRF (cookies cross-site) -----------------------------------
# Con SameSite=None el navegador envía las cookies en requests cross-site; este
# flag exige el header X-Requested-With en mutaciones autenticadas por cookie.
# Activar SOLO cuando el frontend envíe ese header (interceptor HTTP).
APP_CSRF_HEADER_ENABLED=false

# --- CORS / Frontend -------------------------------------------------------
# Dominio(s) del frontend separados por coma (sin barra final).
APP_CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app
APP_FRONTEND_URL=https://tu-frontend.vercel.app

# --- Correo / Notificaciones (Spring Mail / JavaMailSender) ----------------
# El envío de correos se configura por estas variables de entorno, NO por la
# tabla smtp_config (vestigial). En Railway, define estos valores en el panel
# de Variables. Ejemplo con Brevo SMTP (smtp-relay.brevo.com : 587, STARTTLS).
#
# MAIL_ENABLED: interruptor del envío real. En false los correos quedan como
# PENDIENTE en el log sin enviarse (útil en local sin credenciales). Pon true
# cuando SMTP_USER/SMTP_PASSWORD tengan credenciales reales.
MAIL_ENABLED=false
# SMTP_USER = login SMTP del proveedor; SMTP_PASSWORD = su SMTP key (no la API key).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu_login_smtp
SMTP_PASSWORD=tu_smtp_key
# Remitente de los correos. Debe estar verificado en el proveedor SMTP.
MAIL_FROM=no-reply@tudominio.com
MAIL_FROM_NAME=Hotel San Francisco
# Opcional: dirección de respuesta (Reply-To). Vacío = sin Reply-To.
# MAIL_REPLY_TO=

# SMTP_CIPHER_KEY: clave heredada para cifrar credenciales SMTP en BD. Hoy es
# vestigial (la config de correo vive en las variables de arriba), pero se
# conserva por compatibilidad. Debe ser estable entre despliegues.
SMTP_CIPHER_KEY=cambia_esta_clave_de_cifrado_smtp

# --- Integración RENIEC (apisperu.com) -------------------------------------
RENIEC_TOKEN=tu_token_de_apisperu
RENIEC_ENABLED=true
# RENIEC_API_URL=https://dniruc.apisperu.com/api/v1/dni

# --- Integración RENIEC de respaldo (apis.net.pe) ---------------------------
# Se consulta automáticamente si el primario falla o no encuentra el DNI.
# Con RENIEC_FALLBACK_TOKEN vacío el respaldo queda inactivo.
RENIEC_FALLBACK_TOKEN=tu_token_de_apis_net_pe
RENIEC_FALLBACK_ENABLED=true
# RENIEC_FALLBACK_API_URL=https://api.apis.net.pe/v2/reniec/dni

# --- Reserva online --------------------------------------------------------
RESERVA_ONLINE_USUARIO_ID=1
RESERVA_ONLINE_CANAL_NOMBRE=ONLINE

# --- Integración Niubiz (Pasarela de pagos) --------------------------------
# Ambiente de test (documentación oficial: desarrolladores.niubiz.com.pe).
# En producción sobreescribe estos valores con las credenciales del comercio.
NIUBIZ_ENABLED=true
NIUBIZ_BASE_URL=https://apitestenv.vnforapps.com
NIUBIZ_MERCHANT_ID=456879852
NIUBIZ_USER=integraciones@niubiz.com.pe
NIUBIZ_PASSWORD=_7z3@8fF
NIUBIZ_CHECKOUT_SCRIPT_URL=https://static-content-qas.vnforapps.com/v2/js/checkout.js?qa=true
# NIUBIZ_SESSION_EXPIRATION_MINUTES=15

# --- Cache (opcional; tienen defaults) -------------------------------------
# CACHE_MAX_SIZE=1000
# CACHE_EXPIRE_AFTER_WRITE=15m

# --- Logging (opcional; en producción conviene bajar el verbosity) ---------
LOG_LEVEL_SQL=WARN
LOG_LEVEL_BIND=WARN
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=WARN
LOG_LEVEL_FLYWAY=INFO

# --- Actuator (opcional) ---------------------------------------------------
# ACTUATOR_EXPOSE=health

# --- Swagger (por defecto DESACTIVADO; habilítalo solo en dev) --------------
# SWAGGER_ENABLED=true
